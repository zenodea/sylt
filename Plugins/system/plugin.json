{
  "protocol": 1,
  "id": "system",
  "name": "System load",
  "description": "CPU, memory and GPU use as small graphs.",
  "symbol": "gauge.with.dots.needle.33percent",
  "run": "system.py",
  "opens": "com.apple.ActivityMonitor",
  "side": "right",
  "enabledByDefault": false,
  "settings": [
    { "key": "wing", "title": "In the wing", "type": "choice", "default": "cpu", "options": ["cpu", "memory", "gpu", "all", "none"] },
    { "key": "percent", "title": "Show the percentage next to it", "type": "bool", "default": true }
  ]
}
