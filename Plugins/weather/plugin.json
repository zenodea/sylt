{
  "protocol": 1,
  "id": "weather",
  "name": "Weather",
  "description": "Current conditions where the Mac is, from Open-Meteo.",
  "symbol": "cloud.sun.fill",
  "run": "weather.py",
  "interval": 1800,
  "settings": [
    { "key": "units", "title": "Units", "type": "choice", "options": ["celsius", "fahrenheit"], "default": "celsius" }
  ]
}
