{
  "protocol": 1,
  "id": "traffic",
  "name": "Network traffic",
  "description": "Bytes in and out as two small graphs, with the current rate.",
  "symbol": "arrow.up.arrow.down",
  "run": "traffic.py",
  "side": "right",
  "enabledByDefault": false,
  "settings": [
    { "key": "interface", "title": "Interface (blank for the busiest)", "type": "text", "default": "" },
    { "key": "showRate", "title": "Show the rate as text", "type": "bool", "default": false },
    { "key": "rateAbove", "title": "Only above, in kB/s", "type": "number", "default": 50 }
  ]
}
